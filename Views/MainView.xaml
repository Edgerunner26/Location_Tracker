<?xml version="1.0" encoding="utf-8" ?>
<!-- Main page: a full-screen heat map titled "MainView". -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HeatMapApp.Controls"
             x:Class="HeatMapApp.Views.MainView"
             Title="MainView">
    <controls:HeatMap x:Name="HeatMapControl"
                      Points="{Binding Points}"
                      MapType="Street" />
</ContentPage>